+        withTemporaryCommunicationAudio {
+            playProbe48kStereo(
+                routeIndex, driverRouteProbeLabel(routeIndex), navigationToneAttributes,
+                AudioDeviceInfo.TYPE_TELEPHONY, frequencyHz, durationMs
+            )
